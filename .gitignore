# Ensure you are in your project folder
cd /path/to/granulosa-transcriptomics

# Create .gitignore to prevent pushing heavy data files
cat << 'EOF' > .gitignore
# Ignore heavy single-cell data files
data/*.h5ad
*.h5ad

# Ignore output results generated by running scripts
results/
data/granulosa_density_analyzed.h5ad

# Python environment and cache
scvi_env/
__pycache__/
*.pyc
.DS_Store
EOF

# Create a empty placeholder so Git preserves the data/ folder structure
mkdir -p data
touch data/.gitkeep